# EcoAir AI - variables de entorno. Copia a .env y rellena. NUNCA subas .env a Git.
# Este archivo solo lleva nombres y marcadores, ningun valor real.

# ---------- Base de datos ----------
# Local (docker compose): solo hace falta la clave.
POSTGRES_PASSWORD=cambia-esto
# Railway u otra plataforma: si existe DATABASE_URL, tiene prioridad sobre DB_* y POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
# Fuera de Docker (scripts en el Mac): DB_HOST=localhost, DB_PORT=5433 (valores por defecto).
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=ecoair
# DB_USER=ecoair

# ---------- MQTT (Mosquitto) ----------
# Con estas cuatro variables Mosquitto exige usuario/clave y aplica el ACL:
#   dispositivo: solo publica en ecoair/+/telemetry · ingestor: solo se suscribe.
# Sin ellas, el compose local mantiene el modo anonimo (MQTT_ALLOW_ANONYMOUS=true).
MQTT_DEVICE_USER=
MQTT_DEVICE_PASSWORD=
MQTT_INGESTOR_USER=
MQTT_INGESTOR_PASSWORD=
# Solo local. En Railway debe quedar sin definir o en false.
# MQTT_ALLOW_ANONYMOUS=true
# Ingestor fuera del compose (en el compose se toman de MQTT_INGESTOR_*):
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_CA_CERT=

# ---------- API y dashboard ----------
# Contacto del responsable para el texto de consentimiento (Ley 1581). Sin valor inventado.
CONTACT_EMAIL=
# true solo detras de un proxy (Railway, tunel de Cloudflare)
TRUST_PROXY_HEADERS=false
# Punto APROXIMADO de la estacion EcoAir en el mapa del panel, "lat,lon" (se redondea a 2 decimales,
# ~1 km). Nunca una direccion exacta. Vacio = el marcador de EcoAir no se dibuja.
ECOAIR_UBICACION_APROX=
# Railway asigna PORT; en local la API usa 8000.
# PORT=8000

# ---------- Notifier (correo) ----------
# URL publica del panel (enlaces de confirmar, baja y panel en los correos). La api la usa tambien
# para el codigo QR del pie del panel (BASE_URL + /panel).
BASE_URL=http://localhost:8000
# Cadena aleatoria larga, p. ej.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SUBSCRIPTION_SECRET=
# true = escribe el correo en el log y no lo envia (por defecto true)
NOTIFIER_DRY_RUN=true
NOTIFY_ON_CLOSE=false
# Demo con la estacion simulada (tools/simular_estacion.py): evaluar y notificar alertas simuladas.
# Quedan marcadas [SIMULACIÓN] en la alerta, el correo y el panel.
ALERTER_INCLUIR_SIMULADOS=false
NOTIFIER_INCLUIR_SIMULADOS=false
# Capa EXPERIMENTAL de anomalias (Isolation Forest) en el alerter; solo dispositivos simulados.
ANOMALIAS_ACTIVAS=false
# Correos de anomalias (severidad info): apagados; si se activan, max. 1 por dispositivo cada 6 h.
ANOMALIAS_CORREO=false
# Alertas "Dispositivo caido" (device_down). true = como siempre. false = el alerter no las abre y
# cierra en silencio las abiertas, el notifier no envia sus correos y la api no las muestra.
# Poner el MISMO valor en alerter, notifier y api. Reversible (volver a true). No borra filas.
ALERTA_DISPOSITIVO_CAIDO_ACTIVA=true
# Rutas de modelos (opcional; por defecto modelos/ dentro de cada imagen)
# MODELO_PREDICCION_PATH=
# ANOMALIAS_MODELO_PATH=
# Proveedor: smtp (por defecto) o brevo
EMAIL_PROVIDER=smtp
# Remitente (en Brevo debe estar verificado). SMTP_FROM sigue valiendo como alias.
EMAIL_FROM=
# Brevo (API HTTP): clave de API v3
BREVO_API_KEY=
# SMTP (p. ej. Gmail con contrasena de aplicacion)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
